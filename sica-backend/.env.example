# Host e porta do servidor FastAPI
SICA_HOST=0.0.0.0
SICA_PORT=8000

# Origens CORS permitidas (separadas por vírgula)
SICA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Tamanho máximo de upload em MB
SICA_MAX_UPLOAD_MB=10

# Rate limiting (requisições por período em segundos)
SICA_RATE_LIMIT_REQUESTS=10
SICA_RATE_LIMIT_PERIOD=60

# Cache de resultados
SICA_ENABLE_CACHE=true
SICA_CACHE_SIZE=100
SICA_CACHE_TTL=3600

# API Key para autenticação (opcional - se não definido, autenticação é desabilitada)
# SICA_API_KEY=your-secret-api-key-here
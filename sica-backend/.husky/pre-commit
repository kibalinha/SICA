#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# Run linting with ruff
echo "📝 Linting..."
ruff check .
if [ $? -ne 0 ]; then
  echo "❌ Linting failed. Run 'ruff check . --fix' to fix."
  exit 1
fi

# Run formatting check
echo "🎨 Checking formatting..."
ruff format . --check
if [ $? -ne 0 ]; then
  echo "❌ Formatting check failed. Run 'ruff format .' to fix."
  exit 1
fi

# Run type checking
echo "🔧 Type checking..."
mypy .
if [ $? -ne 0 ]; then
  echo "❌ Type checking failed."
  exit 1
fi

# Run tests
echo "🧪 Running tests..."
pytest tests/ -v --tb=short
if [ $? -ne 0 ]; then
  echo "❌ Tests failed."
  exit 1
fi

echo "✅ All pre-commit checks passed!"